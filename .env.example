# FalkorDB (local docker defaults; for FalkorDB Cloud set host/port/username/password)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Optional LLM. Any OpenAI-compatible endpoint works; with no key the app answers from the graph alone.
# Free: get a Gemini key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama
